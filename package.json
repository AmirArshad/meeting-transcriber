{
  "name": "avanevis",
  "version": "2.7.0",
  "description": "AvaNevis private meeting recorder and local AI transcriber",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "npm run test:syntax && npm run test:js",
    "test:js": "node --test",
    "test:python": "node scripts/run-python-tests.js",
    "test:python-syntax": "node scripts/check-python-syntax.js",
    "test:all": "npm test && npm run test:python && npm run test:python-syntax",
    "benchmark:finalization": "node scripts/run-finalization-benchmark.js",
    "test:syntax": "node scripts/check-js-syntax.js",
    "clean": "node scripts/clean-dist.js",
    "prepare-build": "npm run clean && node build/prepare-resources.js",
    "legal:sbom": "node scripts/generate-python-sbom.js",
    "legal:release-assets": "node scripts/stage-release-legal-assets.js",
    "build": "npm run prepare-build && electron-builder build --win --publish never",
    "build:dir": "npm run prepare-build && electron-builder build --win --dir",
    "build:mac": "node scripts/check-mac-signing-identity.js && npm run prepare-build && electron-builder build --mac --publish never",
    "build:mac:dir": "npm run prepare-build && electron-builder build --mac --dir",
    "verify:mac:packaged": "bash scripts/verify-macos-packaged-app.sh",
    "build:linux": "npm run prepare-build && electron-builder build --linux --x64 --publish never",
    "build:linux:dir": "npm run prepare-build && electron-builder build --linux dir --x64 --publish never",
    "verify:linux:packaged": "node scripts/verify-linux-packaging.js"
  },
  "keywords": [
    "transcription",
    "whisper",
    "meeting",
    "audio"
  ],
  "author": "AvaNevis",
  "homepage": "https://github.com/AmirArshad/meeting-transcriber",
  "desktopName": "avanevis",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "0.6.0"
  },
  "devDependencies": {
    "electron": "^42.9.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "tar": "7.5.22",
    "undici@6": "6.28.0",
    "undici@7": "7.29.0"
  },
  "build": {
    "appId": "com.avanevis.app",
    "productName": "AvaNevis",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "AudioVideo",
      "executableName": "avanevis",
      "syncDesktopName": true,
      "synopsis": "Private meeting recorder and local AI transcriber",
      "maintainer": "AvaNevis <AmirArshad@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "AvaNevis",
          "Comment": "Private meeting recorder and local AI transcriber",
          "Categories": "AudioVideo;Audio;Office;Utility;"
        }
      },
      "extraResources": [
        {
          "from": "requirements-linux.txt",
          "to": "requirements-linux.txt"
        },
        {
          "from": "requirements-linux-build.txt",
          "to": "requirements-linux-build.txt"
        }
      ]
    },
    "pacman": {
      "artifactName": "${productName}-Setup-${version}.pkg.tar.zst",
      "compression": "zstd",
      "depends": [
        "alsa-lib",
        "at-spi2-core",
        "dbus",
        "gtk3",
        "libnotify",
        "libpulse",
        "libsecret",
        "libxss",
        "libxtst",
        "nss",
        "xdg-utils"
      ]
    },
    "deb": {
      "artifactName": "${productName}-Setup-${version}.deb",
      "depends": [
        "libasound2",
        "libatspi2.0-0",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libpulse0",
        "libsecret-1-0",
        "libuuid1",
        "libxss1",
        "libxtst6",
        "xdg-utils"
      ],
      "recommends": []
    },
    "toolsets": {
      "appimage": "1.0.2"
    },
    "mac": {
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "binaries": [
        "Contents/Resources/bin/audiocapture-helper",
        "Contents/Resources/bin/speakrs-cli",
        "Contents/Resources/ffmpeg/ffmpeg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "CFBundleDisplayName": "AvaNevis Meeting Recorder & Transcriber",
        "NSMicrophoneUsageDescription": "AvaNevis needs microphone access to record your voice during meetings.",
        "NSAudioCaptureUsageDescription": "AvaNevis needs system audio access to capture desktop audio locally for meeting transcription.",
        "NSAppleMusicUsageDescription": "AvaNevis does not access your music library.",
        "NSCameraUsageDescription": "AvaNevis does not use your camera.",
        "NSScreenCaptureUsageDescription": "AvaNevis needs screen recording permission to capture system audio (desktop audio) using ScreenCaptureKit. No screen video is recorded, only audio."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AvaNevis Meeting Recorder & Transcriber",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "license": "LICENSE.txt",
      "differentialPackage": true,
      "warningsAsErrors": false,
      "displayLanguageSelector": false
    },
    "compression": "store",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "electronLanguages": [
      "en-US",
      "en",
      "es",
      "fr",
      "de",
      "zh-CN",
      "ja"
    ],
    "files": [
      "src/**/*",
      "THIRD_PARTY_NOTICES.md",
      "legal/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "build/resources/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "build/resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/iconTemplate.png",
        "to": "iconTemplate.png"
      },
      {
        "from": "build/iconTemplate@2x.png",
        "to": "iconTemplate@2x.png"
      },
      {
        "from": "build/iconRecording.png",
        "to": "iconRecording.png"
      },
      {
        "from": "build/iconRecording@2x.png",
        "to": "iconRecording@2x.png"
      },
      {
        "from": "build/iconTrayLinux.png",
        "to": "iconTrayLinux.png"
      },
      {
        "from": "build/iconTrayLinuxRecording.png",
        "to": "iconTrayLinuxRecording.png"
      },
      {
        "from": "build/recording-overlay.png",
        "to": "recording-overlay.png"
      },
      {
        "from": "build/resources/legal",
        "to": "legal",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  }
}
